# ======================= الزامی =======================
# از https://my.telegram.org بگیر (با اکانت تلگرام خودت وارد شو)
API_ID=
API_HASH=

# توکن بات کمکی — از @BotFather بگیر و Inline Mode را برایش فعال کن (/setinline)
BOT_TOKEN=

# کلیدهای Gemini برای .ai (متن) و .tts (صوت) — هر دو از همین استخر می‌خوانند.
# کلیدها را با کاما (یا خط جدید) جدا کن؛ حداقل ۱ و حداکثر ۳۰ کلید.
# کلید را از https://aistudio.google.com بگیر.
GEMINI_API_KEYS=

# سشن‌ها (برای دیپلوی روی هاست — Railway / Docker). با setup_session.py بساز:
#   python3 setup_session.py
# برای اجرای لوکال لازم نیست؛ اگر خالی باشد از فایل سشن محلی استفاده می‌شود.
SESSION_STRING=
HELPER_SESSION_STRING=

# ======================= اختیاری =======================
# مدل متنی پیش‌فرض (پیش‌فرض gemini-3.8-flash؛ با LLM_PROVIDER=openai می‌توانی مدل دیگری بدهی)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_API_KEY=

# توکن Apify (برای .ai و ابزار قیمت) — اختیاری
APIFY_TOKEN=

# پوشه‌ی داده (سشن، کانفیگ، دانلودها). روی Railway روی /data بگذار.
DATA_DIR=

# نام و لینک گیت‌هاب برای «ساخته شده توسط» در /start بات کمکی
MAKER_NAME=achhlhzadh9-ctrl
MAKER_GITHUB_URL=https://github.com/achhlhzadh9-ctrl

# چت (آیدی عددی کانال/گروه/کاربر) که خروجی .tts در آن هم کپی شود؛ خالی = غیرفعال
TTS_COPY_CHAT_ID=

# پروکسی اختیاری — فقط اگر اتصال مستقیم تلگرام/اینترنت نداری:
# هاست و پورت SOCKS5 برای اتصال MTProto (خالی = مستقیم)
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
# آدرس کامل پروکسی SOCKS5 برای yt-dlp / curl / تماس‌های HTTP (مثلا socks5://127.0.0.1:1080)
HTTP_PROXY_URL=
# مسیر node (فقط اگر yt-dlp به js-runtime نیاز داشت؛ خالی = node از PATH خوانده می‌شود)
NODE_PATH=

# فایل محلی کلیدهای جمینای (یک کلید در هر خط) — فقط برای اجرای لوکال، اختیاری
GEMINI_KEYS_FILE=

# NO_PROXY=1 یعنی هیچ پروکسی‌ای برای MTProto استفاده نشود
NO_PROXY=
